# Copier en .env (ou exporter ces variables) pour surcharger les valeurs de dev.
DJANGO_SECRET_KEY=changez-moi
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# sqlite (défaut en dev, aucune installation) ou postgres (production)
DB_ENGINE=sqlite
# Utilisées seulement avec DB_ENGINE=postgres :
POSTGRES_DB=e_commerce
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Paiement Stripe (laisser vide = paiement simulé en développement).
# Clés de TEST : https://dashboard.stripe.com/test/apikeys (sk_test_…)
STRIPE_SECRET_KEY=
# Webhook : `stripe listen --forward-to localhost:8001/api/payments/webhook/` affiche ce secret (whsec_…)
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=eur
FRONTEND_URL=http://localhost:5173
PAYMENT_TIMEOUT_MINUTES=30

# IA du serveur (Ollama). Vide = désactivée (IA du navigateur à la place).
OLLAMA_URL=
OLLAMA_MODEL=qwen3:4b
OLLAMA_FALLBACK_MODELS=llama3.2:3b
OLLAMA_TIMEOUT=170
