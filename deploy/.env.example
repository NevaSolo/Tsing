# Copier en deploy/.env sur le serveur (jamais dans Git), puis compléter.

# Adresse publique du site. Sans nom de domaine : adresse gratuite qui pointe vers l'IP du serveur.
SITE_ADDRESS=tsing.75-119-136-160.nip.io

# Django
# python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false

# Base de données
POSTGRES_DB=tsing
POSTGRES_USER=tsing
# mot de passe long et aléatoire
POSTGRES_PASSWORD=

# Paiement Stripe (clé de test d'abord ; clé live seulement après activation du compte)
STRIPE_SECRET_KEY=
# Stripe → Développeurs → Webhooks → https://<SITE_ADDRESS>/api/payments/webhook/
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=eur
PAYMENT_TIMEOUT_MINUTES=30

# IA du serveur (conteneur Ollama existant)
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_FALLBACK_MODELS=llama3.2:3b
OLLAMA_TIMEOUT=170

# Mode autonome (Tsing seul sur le serveur) : laisser tel quel, Caddy obtient le certificat HTTPS.
# Mode « derrière le Caddy principal » (serveur partagé) : décommenter ces lignes.
# CADDY_SITE=:80
# HTTP_PUBLISH=127.0.0.1:4350
# HTTPS_PUBLISH=127.0.0.1:4351
# Réseau Docker du conteneur Ollama (docker inspect ollama)
# AI_NETWORK=ai
