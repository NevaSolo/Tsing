# Copier en deploy/.env sur le serveur (jamais dans Git), puis compléter.

# Adresse du site. Sans nom de domaine : adresse gratuite qui pointe vers l'IP du serveur.
SITE_ADDRESS=tsing.75.119.136.160.sslip.io

# Django
# python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false

# Base de données
POSTGRES_DB=tsing
POSTGRES_USER=tsing
# mot de passe long et aléatoire
POSTGRES_PASSWORD=

# Paiement Stripe (clé de test d'abord ; clé live seulement après activation du compte)
STRIPE_SECRET_KEY=
# Stripe → Développeurs → Webhooks → https://<SITE_ADDRESS>/api/payments/webhook/
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=eur
PAYMENT_TIMEOUT_MINUTES=30

# IA du serveur (conteneur Ollama existant)
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_FALLBACK_MODELS=llama3.2:3b
OLLAMA_TIMEOUT=120

# Ports publics (à changer seulement si 80/443 sont déjà pris par une autre application)
HTTP_PORT=80
HTTPS_PORT=443
